# Copy this file to .env and fill it in. Real environment variables override .env.

# ---- API access ----
# Callers send:  Authorization: Bearer <API_KEY>
# Leave empty to use the key generated in data/api.key on first start.
API_KEY=
# Requests from this computer (the web page) work without the key. Set to false if a reverse
# proxy on this machine forwards internet traffic without adding an X-Forwarded-For header.
TRUST_LOCALHOST=true

# ---- S3 uploads (leave S3_BUCKET empty to turn uploads off) ----
S3_BUCKET=
S3_REGION=ap-southeast-1
# Folder inside the bucket. Must be publicly readable (see README, "S3 setup").
S3_PREFIX=watermarked/
# IAM user with s3:PutObject and s3:DeleteObject on arn:aws:s3:::<bucket>/watermarked/*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: return links on your own domain / CloudFront instead of the bucket URL.
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: only for S3-compatible services (Cloudflare R2, MinIO, ...).
# S3_ENDPOINT=

# ---- Server ----
PORT=3000
