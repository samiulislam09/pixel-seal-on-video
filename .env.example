# Copy this file to .env and fill it in. Real environment variables override .env.

# ---- API access ----
# Callers send:  Authorization: Bearer <API_KEY>
# Leave empty to use the key generated in data/api.key on first start.
API_KEY=
# Requests from this computer (the web page) work without the key. Set to false if a reverse
# proxy on this machine forwards internet traffic without adding an X-Forwarded-For header.
TRUST_LOCALHOST=true

# ---- Server ----
PORT=3000

# ---- Public access (scripts\host.ps1) ----
# Token of a named Cloudflare Tunnel, for a fixed address like https://watermark.example.com.
# Leave empty to use a free quick tunnel (random address, changes on restart; see storage\public-url.txt).
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Browser uploads / downloads ----
# Comma-separated origins allowed to call /api/uploads/* and /api/videos/:id/file from a browser
# (for example https://app.xchat.example). Empty = no cross-origin access.
CORS_ORIGINS=
